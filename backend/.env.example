# Copy to backend/.env and fill in ANTHROPIC_API_KEY.

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgresql+psycopg://rbac:rbac@localhost:5432/rbac_poc

# Claude (primary)
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5

# Gemini (fallback, used when a Claude call fails). Leave blank to disable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
LLM_FALLBACK_ENABLED=true

# JWT — replace with a random string in any non-local use
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Password used by seed.py for every test user
SEED_PASSWORD=password123

# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
