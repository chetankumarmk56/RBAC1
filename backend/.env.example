# Copy to backend/.env and fill in ANTHROPIC_API_KEY.

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgresql+psycopg://rbac:rbac@localhost:5432/rbac_poc

# Claude. Which of these tiers a role may actually run is stored in PostgreSQL and
# edited from the Access control page — these settings only name the model ids.
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_OPUS_MODEL=claude-opus-5
CLAUDE_SONNET_MODEL=claude-sonnet-5
CLAUDE_HAIKU_MODEL=claude-haiku-4-5-20251001

# Gemini (second provider, used when the Claude tiers fail). Leave blank to disable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
LLM_FALLBACK_ENABLED=true

# JWT — replace with a random string in any non-local use
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Password used by seed.py for every test user
SEED_PASSWORD=password123

# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
