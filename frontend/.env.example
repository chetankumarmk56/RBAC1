# Optional. Only needed if the backend does not run on http://localhost:8010.
# Used by vite.config.ts to point the /api dev-server proxy somewhere else.
VITE_API_TARGET=http://localhost:8010

# Set for a deployed build when the API is on a different origin than the
# frontend (e.g. a static site in front of a separate backend service).
# Leave blank in development — Vite proxies /api instead.
VITE_API_BASE_URL=
